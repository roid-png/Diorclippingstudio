{
  "id": "viral-motion",
  "name": "Viral Motion",
  "description": "Subtitle animasi pop-up kinetik dengan highlight warna kuning stabilo pada kata aktif, bersih tanpa label narasumber/host.",
  "format": "9:16",
  "width": 1080,
  "height": 1920,
  "colorGrading": "eq=contrast=1.08:brightness=0.02:saturation=1.25",
  "transition": "zoom-in",
  "subtitleStyle": {
    "fontName": "Impact",
    "fontSize": 28,
    "primaryColor": "&H00FFFFFF",
    "highlightColor": "#FACC15",
    "outlineColor": "&H00000000",
    "outlineWidth": 3,
    "alignment": 2,
    "marginV": 370,
    "bold": true,
    "animation": "bounce-popup",
    "bounceScale": 1.2,
    "showSpeakerTag": false
  },
  "motionGraphic": {
    "progressBar": false,
    "punchZoom": true,
    "punchZoomScale": 1.15
  },
  "accentColor": "#FACC15",
  "primaryAccentHex": "#FACC15"
}