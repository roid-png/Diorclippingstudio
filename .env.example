# ===================================================================
# DIOR CLIPPING STUDIO - ENVIRONMENT CONFIGURATION (CODESPACES & LOCAL)
# ===================================================================

# GEMINI PRIMARY KEYS
GEMINI_API_KEY=
GEMINI_API_KEY_TRANSCRIPTION=
GEMINI_API_KEY_CURATOR=
GEMINI_API_KEY_CURATION=
GEMINI_API_KEY_ART_DIRECTOR=
GEMINI_API_KEY_STYLE_CLONER=

# GEMINI BACKUP KEYS (AUTOMATIC FAILOVER)
GEMINI_API_KEY_BACKUP=
GEMINI_API_KEY_TRANSCRIPTION_BACKUP=
GEMINI_API_KEY_CURATOR_BACKUP=
GEMINI_API_KEY_CURATION_BACKUP=
GEMINI_API_KEY_ART_DIRECTOR_BACKUP=
GEMINI_API_KEY_STYLE_CLONER_BACKUP=

# GROQ KEYS (AUDIO TRANSCRIBER FAILOVER & BACKSOUND AI MATCHER)
GROQ_API_KEY_PRIMARY=
GROQ_API_KEY_BACKUP=
GROQ_API_KEY_BACKSOUND=

# SERVER PORTS & URLS
# Port 5000 is forwarded as 'Backend API & Media Server' in Codespaces
PORT=5000
BETTER_AUTH_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000
WEB_URL=http://localhost:3000

# AUTH & SECURITY
BETTER_AUTH_SECRET=your_32_characters_random_secret_string_here

# DATABASE (PostgreSQL) - Optional in local, or supply connection string
DATABASE_URL=postgresql://starter:starter@127.0.0.1:5432/starter

