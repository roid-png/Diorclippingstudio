{
  "id": "renx-viral-clipper",
  "name": "Renx Viral Clipper (1-Word Pop + Glow Hook)",
  "description": "Gaya viral TikTok/Reels ala @renxclip tanpa banner atas, font glowing hook di awal, dan subtitle 1 kata per 1 kata.",
  "format": "9:16",
  "width": 1080,
  "height": 1920,
  "colorGrading": "eq=contrast=1.12:brightness=0.01:saturation=1.28",
  "transition": "zoom-in",
  "pipelineMode": "clone_only",
  "accentColor": "#FF6B00",
  "enableHook": true,
  "enableTopMotion": false,
  "enablePolish": true,
  "badge": "Viral Clipper",
  "isCustom": false,
  "isCloned": false,
  "layoutArchitecture": "IN_SCENE_KINETIC_CLIPPER",
  "subtitleBehavior": "SINGLE_WORD_POP",
  "hookTypographyStyle": "GLOWING_STACKED_IMPACT",
  "styleVariant": 0,
  "subtitleStyle": {
    "fontName": "Montserrat ExtraBold",
    "fontSize": 36,
    "primaryColor": "#FFFFFF",
    "highlightColor": "#FF6B00",
    "outlineColor": "#000000",
    "outlineWidth": 4,
    "alignment": 2,
    "marginV": 440,
    "bold": true,
    "animation": "single-word-pop",
    "bounceScale": 1.25,
    "showSpeakerTag": false
  },
  "motionGraphic": {
    "progressBar": false,
    "punchZoom": true,
    "punchZoomScale": 1.15
  }
}
