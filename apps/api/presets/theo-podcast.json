{
  "id": "theo-podcast",
  "name": "THEO Podcast Dark",
  "description": "Format ambient blur 9:16 dengan layout narasumber, dark teal mood.",
  "format": "9:16",
  "width": 1080,
  "height": 1920,
  "colorGrading": "eq=contrast=1.15:brightness=-0.02:saturation=1.10",
  "transition": "cut",
  "subtitleStyle": {
    "fontName": "Montserrat",
    "fontSize": 26,
    "primaryColor": "&H00FFFFFF",
    "highlightColor": "&H0020E5FF",
    "outlineColor": "&H00000000",
    "outlineWidth": 2.5,
    "alignment": 2,
    "marginV": 100,
    "bold": true,
    "animation": "word-by-word"
  },
  "motionGraphic": {
    "progressBar": true,
    "punchZoom": false
  }
}

